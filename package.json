{
  "name": "azure-devops-boards",
  "displayName": "ADO Boards",
  "description": "Unofficial, community-maintained Azure DevOps Boards integration for VS Code. Manage work items, boards, sprints and backlogs without leaving your editor.",
  "version": "0.3.0",
  "publisher": "zollo",
  "author": {
    "name": "Joe Zollo",
    "url": "https://github.com/zollo"
  },
  "contributors": [
    {
      "name": "Damilola Onadeinde",
      "url": "https://github.com/dammyboss"
    }
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "azureDevOps.connect",
        "title": "Connect to Organization",
        "category": "Azure DevOps",
        "icon": "$(plug)"
      },
      {
        "command": "azureDevOps.disconnect",
        "title": "Disconnect",
        "category": "Azure DevOps",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "azureDevOps.checkConnection",
        "title": "Check Connection",
        "category": "Azure DevOps",
        "icon": "$(pulse)"
      },
      {
        "command": "azureDevOps.reauthenticate",
        "title": "Sign In Again",
        "category": "Azure DevOps",
        "icon": "$(key)"
      },
      {
        "command": "azureDevOps.createWorkItem",
        "title": "Create Work Item",
        "category": "Azure DevOps",
        "icon": "$(add)"
      },
      {
        "command": "azureDevOps.searchWorkItems",
        "title": "Search Work Items",
        "category": "Azure DevOps",
        "icon": "$(search)"
      },
      {
        "command": "azureDevOps.quickOpenWorkItem",
        "title": "Quick Open Work Item",
        "category": "Azure DevOps",
        "icon": "$(search)"
      },
      {
        "command": "azureDevOps.showActiveWorkItemActions",
        "title": "Show Active Work Item Actions",
        "category": "Azure DevOps",
        "icon": "$(list-unordered)"
      },
      {
        "command": "azureDevOps.refresh",
        "title": "Refresh",
        "category": "Azure DevOps",
        "icon": "$(refresh)"
      },
      {
        "command": "azureDevOps.openBoard",
        "title": "Open Board in Browser",
        "category": "Azure DevOps",
        "icon": "$(link-external)"
      },
      {
        "command": "azureDevOps.openSprint",
        "title": "Open Sprint in Browser",
        "category": "Azure DevOps",
        "icon": "$(link-external)"
      },
      {
        "command": "azureDevOps.startWorking",
        "title": "Start Working On...",
        "category": "Azure DevOps",
        "icon": "$(play)"
      },
      {
        "command": "azureDevOps.stopWorking",
        "title": "Stop Working",
        "category": "Azure DevOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "azureDevOps.openWorkItem",
        "title": "Open Work Item in Browser",
        "category": "Azure DevOps",
        "icon": "$(link-external)"
      },
      {
        "command": "azureDevOps.filterWorkItems",
        "title": "Filter Work Items",
        "category": "Azure DevOps",
        "icon": "$(filter)"
      },
      {
        "command": "azureDevOps.createBranchFromWorkItem",
        "title": "Create Branch from Work Item",
        "category": "Azure DevOps",
        "icon": "$(git-branch)"
      },
      {
        "command": "azureDevOps.editWorkItem",
        "title": "Edit Work Item",
        "category": "Azure DevOps",
        "icon": "$(edit)"
      },
      {
        "command": "azureDevOps.changeWorkItemState",
        "title": "Change Work Item State",
        "category": "Azure DevOps",
        "icon": "$(symbol-event)"
      },
      {
        "command": "azureDevOps.assignWorkItem",
        "title": "Assign Work Item",
        "category": "Azure DevOps",
        "icon": "$(person)"
      },
      {
        "command": "azureDevOps.bulkChangeState",
        "title": "Bulk: Change State",
        "category": "Azure DevOps",
        "icon": "$(symbol-event)"
      },
      {
        "command": "azureDevOps.bulkAssign",
        "title": "Bulk: Assign",
        "category": "Azure DevOps",
        "icon": "$(person)"
      },
      {
        "command": "azureDevOps.bulkMoveToSprint",
        "title": "Bulk: Move to Sprint",
        "category": "Azure DevOps",
        "icon": "$(calendar)"
      },
      {
        "command": "azureDevOps.viewWorkItemDetails",
        "title": "View Work Item Details",
        "category": "Azure DevOps",
        "icon": "$(preview)"
      },
      {
        "command": "azureDevOps.addWorkItemComment",
        "title": "Add Comment to Work Item",
        "category": "Azure DevOps",
        "icon": "$(comment)"
      },
      {
        "command": "azureDevOps.createPullRequest",
        "title": "Create Pull Request",
        "category": "Azure DevOps",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "azureDevOps.selectProject",
        "title": "Select Project",
        "category": "Azure DevOps",
        "icon": "$(folder)"
      },
      {
        "command": "azureDevOps.selectTeam",
        "title": "Select Team",
        "category": "Azure DevOps",
        "icon": "$(organization)"
      },
      {
        "command": "azureDevOps.runQuery",
        "title": "Run Saved Query",
        "category": "Azure DevOps",
        "icon": "$(play)"
      },
      {
        "command": "azureDevOps.commitWithWorkItem",
        "title": "Commit with Work Item Link",
        "category": "Azure DevOps",
        "icon": "$(git-commit)"
      },
      {
        "command": "azureDevOps.refreshWorkItems",
        "title": "Refresh Work Items",
        "category": "Azure DevOps",
        "icon": "$(refresh)"
      },
      {
        "command": "azureDevOps.openWorkItemsPanel",
        "title": "Open Work Items in Editor",
        "category": "Azure DevOps",
        "icon": "$(link-external)"
      },
      {
        "command": "azureDevOps.refreshBoards",
        "title": "Refresh Boards",
        "category": "Azure DevOps",
        "icon": "$(refresh)"
      },
      {
        "command": "azureDevOps.refreshSprints",
        "title": "Refresh Sprints",
        "category": "Azure DevOps",
        "icon": "$(refresh)"
      },
      {
        "command": "azureDevOps.refreshQueries",
        "title": "Refresh Queries",
        "category": "Azure DevOps",
        "icon": "$(refresh)"
      },
      {
        "command": "azureDevOps.groupWorkItems",
        "title": "Group Work Items",
        "category": "Azure DevOps",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "azureDevOps.copyWorkItemId",
        "title": "Copy Work Item ID",
        "category": "Azure DevOps",
        "icon": "$(copy)"
      },
      {
        "command": "azureDevOps.copyWorkItemUrl",
        "title": "Copy Work Item URL",
        "category": "Azure DevOps",
        "icon": "$(link)"
      },
      {
        "command": "azureDevOps.assignToMe",
        "title": "Assign to Me",
        "category": "Azure DevOps",
        "icon": "$(account)"
      },
      {
        "command": "azureDevOps.linkToExisting",
        "title": "Link to Existing Work Item",
        "category": "Azure DevOps",
        "icon": "$(link)"
      },
      {
        "command": "azureDevOps.createAndLink",
        "title": "Create and Link New Work Item",
        "category": "Azure DevOps",
        "icon": "$(add)"
      },
      {
        "command": "azureDevOps.openBoardPanel",
        "title": "Open Board (Kanban View)",
        "category": "Azure DevOps",
        "icon": "$(project)"
      },
      {
        "command": "azureDevOps.setupWizard",
        "title": "Setup Connection Wizard",
        "category": "Azure DevOps",
        "icon": "$(settings-gear)"
      },
      {
        "command": "azureDevOps.showWhatsNew",
        "title": "Show What's New",
        "category": "Azure DevOps",
        "icon": "$(gift)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azure-devops",
          "title": "Azure DevOps",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "azure-devops": [
        {
          "id": "azureDevOpsConnection",
          "name": "Connection",
          "icon": "$(debug-disconnect)",
          "contextualTitle": "Azure DevOps Connection Status"
        },
        {
          "id": "azureDevOpsWorkItems",
          "name": "Work Items",
          "icon": "$(tasklist)",
          "contextualTitle": "Azure DevOps Work Items"
        },
        {
          "id": "azureDevOpsBacklogs",
          "name": "Backlogs",
          "icon": "$(list-tree)",
          "contextualTitle": "Azure DevOps Backlogs"
        },
        {
          "id": "azureDevOpsBoards",
          "name": "Boards",
          "icon": "$(project)",
          "contextualTitle": "Azure DevOps Boards"
        },
        {
          "id": "azureDevOpsSprints",
          "name": "Sprints",
          "icon": "$(calendar)",
          "contextualTitle": "Azure DevOps Sprints"
        },
        {
          "id": "azureDevOpsQueries",
          "name": "Queries",
          "icon": "$(search)",
          "contextualTitle": "Azure DevOps Queries"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "azureDevOpsConnection",
        "contents": "Welcome to Azure DevOps Boards!\n\n[$(sign-in) Sign In to Azure DevOps](command:azureDevOps.connect)\n\nConnect with your Microsoft account to manage work items, boards, and sprints.",
        "when": "!azureDevOps.signedIn"
      },
      {
        "view": "azureDevOpsWorkItems",
        "contents": "Not Connected",
        "when": "!azureDevOps.connected"
      },
      {
        "view": "azureDevOpsBacklogs",
        "contents": "Not Connected",
        "when": "!azureDevOps.connected"
      },
      {
        "view": "azureDevOpsBoards",
        "contents": "Not Connected",
        "when": "!azureDevOps.connected"
      },
      {
        "view": "azureDevOpsSprints",
        "contents": "Not Connected",
        "when": "!azureDevOps.connected"
      },
      {
        "view": "azureDevOpsQueries",
        "contents": "Not Connected",
        "when": "!azureDevOps.connected"
      }
    ],
    "keybindings": [
      {
        "command": "azureDevOps.quickOpenWorkItem",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "azureDevOps.connected"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "azureDevOps.disconnect",
          "when": "view == azureDevOpsConnection && azureDevOps.connected",
          "group": "navigation"
        },
        {
          "command": "azureDevOps.connect",
          "when": "view == azureDevOpsConnection && !azureDevOps.connected",
          "group": "navigation"
        },
        {
          "command": "azureDevOps.createWorkItem",
          "when": "view == azureDevOpsWorkItems",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.groupWorkItems",
          "when": "view == azureDevOpsWorkItems",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.filterWorkItems",
          "when": "view == azureDevOpsWorkItems",
          "group": "navigation@3"
        },
        {
          "command": "azureDevOps.searchWorkItems",
          "when": "view == azureDevOpsWorkItems",
          "group": "navigation@4"
        },
        {
          "command": "azureDevOps.refreshWorkItems",
          "when": "view == azureDevOpsWorkItems",
          "group": "navigation@5"
        },
        {
          "command": "azureDevOps.openWorkItemsPanel",
          "when": "view == azureDevOpsWorkItems",
          "group": "navigation@6"
        },
        {
          "command": "azureDevOps.openBoardPanel",
          "when": "view == azureDevOpsBoards",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.refreshBoards",
          "when": "view == azureDevOpsBoards",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.refreshSprints",
          "when": "view == azureDevOpsSprints",
          "group": "navigation"
        },
        {
          "command": "azureDevOps.refreshQueries",
          "when": "view == azureDevOpsQueries",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "azureDevOps.openWorkItem",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.viewWorkItemDetails",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.editWorkItem",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "1_modify@1"
        },
        {
          "command": "azureDevOps.changeWorkItemState",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "1_modify@2"
        },
        {
          "command": "azureDevOps.assignWorkItem",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "1_modify@3"
        },
        {
          "command": "azureDevOps.assignToMe",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "1_modify@4"
        },
        {
          "command": "azureDevOps.addWorkItemComment",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "2_actions@1"
        },
        {
          "command": "azureDevOps.createBranchFromWorkItem",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "2_actions@2"
        },
        {
          "command": "azureDevOps.startWorking",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "2_actions@3"
        },
        {
          "command": "azureDevOps.copyWorkItemId",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "3_copy@1"
        },
        {
          "command": "azureDevOps.copyWorkItemUrl",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "3_copy@2"
        },
        {
          "command": "azureDevOps.linkToExisting",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "4_link@1"
        },
        {
          "command": "azureDevOps.createAndLink",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "4_link@2"
        },
        {
          "command": "azureDevOps.bulkChangeState",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "5_bulk@1"
        },
        {
          "command": "azureDevOps.bulkAssign",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "5_bulk@2"
        },
        {
          "command": "azureDevOps.bulkMoveToSprint",
          "when": "view == azureDevOpsWorkItems && viewItem == workItem",
          "group": "5_bulk@3"
        },
        {
          "command": "azureDevOps.openWorkItem",
          "when": "view == azureDevOpsBacklogs && viewItem == workItem",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.viewWorkItemDetails",
          "when": "view == azureDevOpsBacklogs && viewItem == workItem",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.openBoardPanel",
          "when": "view == azureDevOpsBoards && viewItem == board",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.openBoard",
          "when": "view == azureDevOpsBoards && viewItem == board",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.openSprint",
          "when": "view == azureDevOpsSprints && viewItem == sprint",
          "group": "navigation"
        },
        {
          "command": "azureDevOps.runQuery",
          "when": "view == azureDevOpsQueries && viewItem == query",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "azureDevOps.refreshWorkItems",
          "when": "false"
        },
        {
          "command": "azureDevOps.refreshBoards",
          "when": "false"
        },
        {
          "command": "azureDevOps.refreshSprints",
          "when": "false"
        },
        {
          "command": "azureDevOps.refreshQueries",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Azure DevOps Boards",
      "properties": {
        "azureDevOps.organizationUrl": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization URL (e.g., https://dev.azure.com/your-organization)"
        },
        "azureDevOps.personalAccessToken": {
          "type": "string",
          "default": "",
          "description": "Deprecated legacy PAT setting (migrated to secure SecretStorage)",
          "deprecationMessage": "Deprecated: use the Sign In flow with authenticationMethod=pat to securely store your PAT in VS Code SecretStorage.",
          "scope": "application"
        },
        "azureDevOps.authenticationMethod": {
          "type": "string",
          "enum": [
            "oauth",
            "pat"
          ],
          "default": "oauth",
          "description": "Authentication method to use: OAuth (Microsoft account) or PAT (personal access token)"
        },
        "azureDevOps.defaultProject": {
          "type": "string",
          "default": "",
          "description": "Default project to use"
        },
        "azureDevOps.defaultTeam": {
          "type": "string",
          "default": "",
          "description": "Default team to use"
        },
        "azureDevOps.autoRefreshInterval": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Auto-refresh interval in seconds (0 to disable)"
        },
        "azureDevOps.connectionCheckInterval": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "How often, in seconds, to check in the background that Azure DevOps is reachable and your sign-in is still valid (0 to disable). Checks pause while VS Code is not focused."
        },
        "azureDevOps.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for work item updates"
        },
        "azureDevOps.gitIntegration": {
          "type": "boolean",
          "default": true,
          "description": "Enable Git integration (auto-link commits to work items)"
        },
        "azureDevOps.defaultWorkItemType": {
          "type": "string",
          "default": "Task",
          "enum": [
            "User Story",
            "Task",
            "Bug",
            "Epic",
            "Feature",
            "Issue"
          ],
          "description": "Default work item type when creating new items"
        },
        "azureDevOps.branchNameFormat": {
          "type": "string",
          "default": "feature/{id}-{title}",
          "description": "Branch name format when creating branches from work items. Use {id} for work item ID and {title} for sanitized title"
        },
        "azureDevOps.maxWorkItemsToLoad": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum number of work items to load in the tree view"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "check-types": "tsc -p ./ --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "test:integration": "npm run compile && npm run build && vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "axios": "^1.21.1",
    "quill": "^1.3.7",
    "sanitize-html": "^2.18.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zollo/azure-devops-vsce"
  },
  "bugs": {
    "url": "https://github.com/zollo/azure-devops-vsce/issues"
  },
  "homepage": "https://github.com/zollo/azure-devops-vsce#readme",
  "icon": "media/icon.png",
  "keywords": [
    "azure",
    "devops",
    "boards",
    "work-items",
    "sprints",
    "agile",
    "scrum",
    "kanban"
  ]
}
